# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FINANCE_ENCRYPTION_KEY=
FINANCE_DATA_DIR=./data
# A distinct Fernet key for authenticated, fully encrypted snapshot archives.
# Never reuse FINANCE_ENCRYPTION_KEY and keep this outside the repository.
FINANCE_BACKUP_KEY=
FINANCE_BACKUP_DIR=/backups
FINANCE_RELEASE_GATES_FILE=/run/finance/release-gates.json
# Do not reuse an encryption, provider, email, or release credential here.
# Generate a separate random value for private operational health checks.
FINANCE_INTERNAL_KEY=
PLAID_MODE=sandbox
PLAID_ENVIRONMENT=sandbox
# Production reads an authenticated encrypted credential document from these
# separately mounted, read-only files. Plain environment values remain available
# only for local development and tests.
PLAID_CREDENTIALS_FILE=
PLAID_CREDENTIALS_KEY_FILE=
PLAID_CLIENT_ID=
PLAID_SECRET=
# Used only by the private Finance backend to retrieve a cached, adjusted SPY
# benchmark series. Keep it in the production settings file, never in git.
BENCHMARK_ALPHA_VANTAGE_API_KEY=
# Keep Payroll Income in Sandbox until exact account pricing is supplied here,
# displayed in the application, and confirmed with a stored spending cap.
PAYROLL_ENVIRONMENT=sandbox
PAYROLL_INITIAL_PRICE_USD=
PAYROLL_REFRESH_PRICE_USD=
PAYROLL_STALE_AFTER_SECONDS=1209600
# Asset valuation automation is disabled unless a permitted source is explicitly
# acknowledged. Use "fake" only for local tests. The Douglas County adapter is
# read-only and does not provide vehicle values; unsupported assets retain their
# manual valuation with an availability warning.
VALUATION_MODE=disabled
VALUATION_SOURCE_TERMS_URL=
VALUATION_SOURCE_TERMS_ACCEPTED_AT=
VALUATION_SOURCE_USER_AGENT=
# Vehicle values default to a no-network monthly depreciation model based on a
# dated, sourced private-party market anchor. It cannot incur API charges.
# Set disabled to require manual vehicle valuations only.
VEHICLE_VALUATION_MODE=depreciation_model
# Weekly review mail uses the existing household SMTP relay. Keep MAIL_MODE
# disabled until these are configured; tests use the credential-free fake mode.
MAIL_MODE=disabled
FINANCE_REVIEW_EMAIL=
FINANCE_MAIL_FROM=
FINANCE_BASE_URL=https://finance.gordongouger.com
FINANCE_SMTP_HOST=
FINANCE_SMTP_PORT=587
FINANCE_SMTP_USERNAME=
FINANCE_SMTP_PASSWORD=
# Separate random credential used only by the inbound mail-provider webhook.
FINANCE_MAIL_WEBHOOK_KEY=
