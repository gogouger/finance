# Canonical Finance site block. Production includes this behavior in the
# infrastructure repository's complete Caddyfile; keep the two in sync.
finance.gordongouger.com {
	import tls_origin
	import security_headers
	encode gzip

	@finance_public {
		# Keep this browser subrequest public so an in-flight OAuth callback does
		# not have its state cookie overwritten by a second authorization flow.
		path / /favicon.ico /preview /housing /retirement /health /ready /assets/* /api/public/*
	}
	# MCP is OAuth-protected by the Finance resource server itself, not the
	# browser-only OIDC bridge. Keep this list aligned with infra/Caddyfile.
	@mcp_protocol {
		path /mcp /mcp/oauth/token /mcp/oauth/register /.well-known/oauth-authorization-server /.well-known/oauth-protected-resource/mcp
	}
	@finance_preview path /preview
	handle @finance_preview {
		# Public Finance has no third-party runtime resources. The tighter
		# fallback policy is intentionally limited to public routes; Plaid Link
		# remains an authorized external connection surface in the private route.
		header {
			-X-Frame-Options
			Content-Security-Policy "default-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self' https://gordongouger.com"
		}
		reverse_proxy finance:8080
	}
	handle @finance_public {
		header Content-Security-Policy "default-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"
		reverse_proxy finance:8080
	}
	handle @mcp_protocol {
		reverse_proxy finance:8080
	}

	@oidc_browser {
		path /oauth2/start /oauth2/callback /oauth2/logout /oauth2/session /logged-out
	}
	handle @oidc_browser {
		reverse_proxy finance-oidc-bridge:8081
	}

	handle {
		header Content-Security-Policy "object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"
		route {
			request_header -Remote-User
			request_header -X-Forwarded-User
			request_header -X-Auth-Method
			request_header -X-Auth-Time
			request_header -X-Auth-Require-Fresh

			@fresh {
				path /api/private/security/fresh-check /api/private/lifecycle/* /api/private/mcp/grants* /mcp/oauth/authorize /api/private/payroll/approval /api/private/payroll/link-token /api/private/payroll/manual /api/private/payroll/ingest /api/private/investments/imports/*
			}
			request_header @fresh X-Auth-Require-Fresh true
			@fresh_connection_post {
				method POST
				path /api/private/connections/plaid/*
			}
			request_header @fresh_connection_post X-Auth-Require-Fresh true
			@fresh_connection_delete {
				method DELETE
				path /api/private/connections/*
			}
			request_header @fresh_connection_delete X-Auth-Require-Fresh true

			forward_auth finance-oidc-bridge:8081 {
				uri /oauth2/auth
				header_up X-Forwarded-Method {method}
				header_up X-Forwarded-Uri {uri}
				header_up X-Auth-Require-Fresh {http.request.header.X-Auth-Require-Fresh}
				copy_headers X-Forwarded-User X-Auth-Method X-Auth-Time
			}

			reverse_proxy finance:8080 {
				header_up -Remote-User
			}
		}
	}
}
