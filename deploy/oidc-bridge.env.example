# Disabled is the only safe default. Enable only after staging proves that the
# issuer emits the required amr and auth_time claims for a user-verifying passkey.
FINANCE_OIDC_BRIDGE_ENABLED=false
FINANCE_OIDC_ISSUER=https://auth.gordongouger.com
FINANCE_OIDC_CLIENT_ID=finance
FINANCE_OIDC_CLIENT_SECRET=
FINANCE_OIDC_REDIRECT_URI=https://finance.gordongouger.com/oauth2/callback
FINANCE_OIDC_POST_LOGOUT_URI=https://finance.gordongouger.com/logged-out
